local current = en

function Strings.setLocale(localeId: string)
	if string.sub(string.lower(localeId), 1, 2) == "zh" then
		current = zh
	else
		current = en
	end
end

function Strings.get(key: string, ...: any): string
	local text = current[key] or en[key]
	if text == nil then
		-- trail and event names fall back to their id
		local _, id = string.match(key, "^(%a)_(.+)$")
		text = id or key
	end
	if select("#", ...) > 0 then
		return string.format(text :: string, ...)
	end
	return text :: string
end

return Strings
